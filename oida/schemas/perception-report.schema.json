{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oida.local/schemas/perception-report.schema.json",
  "title": "oida PerceptionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "engine",
    "dsp",
    "transcript",
    "events",
    "caption",
    "speech",
    "music",
    "qa",
    "model_uncertainty_notes",
    "forbidden_topics_triggered"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "sr_native": {
          "type": [
            "integer",
            "null"
          ]
        },
        "channels": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daemon",
        "model",
        "profile",
        "params",
        "thinking_budget",
        "chunks",
        "wall_ms"
      ],
      "properties": {
        "daemon": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "top_p",
            "top_k"
          ],
          "properties": {
            "temperature": {
              "type": "number"
            },
            "top_p": {
              "type": "number"
            },
            "top_k": {
              "type": "integer"
            }
          }
        },
        "thinking_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "i",
              "t0",
              "t1"
            ],
            "properties": {
              "i": {
                "type": "integer"
              },
              "t0": {
                "type": "number"
              },
              "t1": {
                "type": "number"
              },
              "source_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "wall_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dsp": {
      "type": "object"
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "language",
        "segments",
        "notes"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t0",
              "t1",
              "text",
              "confidence"
            ],
            "properties": {
              "t0": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "t1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "undetermined"
                ]
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t0",
          "t1",
          "label",
          "description",
          "corroborated_by_dsp",
          "confidence"
        ],
        "properties": {
          "t0": {
            "type": [
              "number",
              "null"
            ]
          },
          "t1": {
            "type": [
              "number",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "corroborated_by_dsp": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "undetermined"
            ]
          }
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dense",
        "brief"
      ],
      "properties": {
        "dense": {
          "type": [
            "string",
            "null"
          ]
        },
        "brief": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "dimensions",
        "identity_caution",
        "notes"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "identity_caution": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "description",
        "tempo_feel",
        "dsp_bpm_candidate",
        "moss_bpm_candidate",
        "notes"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tempo_feel": {
          "type": [
            "string",
            "null"
          ]
        },
        "dsp_bpm_candidate": {
          "type": [
            "number",
            "null"
          ]
        },
        "moss_bpm_candidate": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "reasoning_trace",
          "thinking_budget"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "reasoning_trace": {
            "type": [
              "string",
              "null"
            ]
          },
          "thinking_budget": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "model_uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_topics_triggered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signal_interpretation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Deterministic signal-level reading from measured DSP features (oida signal listener)."
    },
    "moss_passes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which MOSS perception passes ran for this report (route-preset scoped)."
    }
  }
}

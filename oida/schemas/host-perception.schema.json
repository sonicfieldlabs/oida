{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oida.local/schemas/host-perception.schema.json",
  "title": "Oída host perception input",
  "description": "Structured audio perception supplied by Hermes, Codex, Claude, OpenClaw, OpenCode, or another audio-capable host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "source", "observations"],
  "properties": {
    "contract": {"const": "oida/host-perception/v0.3"},
    "host": {
      "type": "object",
      "required": ["id", "model"],
      "properties": {
        "id": {"enum": ["hermes", "codex", "claude", "openclaw", "opencode", "generic"]},
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "audio_input_capable": {"type": "boolean"},
        "thinking_budget": {"type": ["integer", "null"], "minimum": 0},
        "wall_ms": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "listening_identity": {
      "description": "Host declaration that the named LISTENING.md revision oriented this perception. This is provenance, never evidence.",
      "type": "object",
      "required": ["contract", "sha256", "applied"],
      "properties": {
        "contract": {"const": "oida/listening-identity/v0.1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "applied": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["live_input", "system_output", "file", "buffer", "generated", "external_stream"]},
        "uri": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "duration_s": {"type": ["number", "null"], "minimum": 0},
        "sample_rate": {"type": ["integer", "null"], "minimum": 0},
        "channels": {"type": ["integer", "null"], "minimum": 0},
        "audio_available_to_oida": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "apparatus": {
      "type": "object",
      "properties": {
        "substrate": {"type": "string"},
        "perception_sources": {"type": "array", "items": {"type": "string"}},
        "model_ids": {"type": "array", "items": {"type": "string"}},
        "sample_rate_hz": {"type": ["integer", "null"]},
        "channels": {"type": ["integer", "null"]},
        "bandwidth_limit_hz": {"type": ["integer", "null"]},
        "absolute_level_calibrated": {"type": "boolean"},
        "known_blind_spots": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "listening_context": {
      "description": "Host-declared situated listening context. OÍDA preserves this as attributed input but computes effective action authority at the gateway boundary; perceptual capability never grants retention, disclosure, or execution rights.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "position", "apertures", "auditory_scales", "sources_of_listening", "participants", "action_authority", "honest_absences"],
      "properties": {
        "contract": {"const": "akouo/listening-context/v1"},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation_to_object", "limitations"],
          "properties": {
            "relation_to_object": {"type": "string", "minLength": 1},
            "situation": {"type": ["string", "null"]},
            "listening_identity_ref": {"type": ["string", "null"]},
            "limitations": {"$ref": "#/$defs/text_list"}
          }
        },
        "apertures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["direct_audio", "signal_measurement", "metadata", "transcript", "contextual_note", "human_report", "model_observation", "memory", "audiovisual", "haptic", "other"]},
              "status": {"enum": ["available", "unavailable", "withheld", "degraded"]},
              "description": {"type": "string"},
              "limits": {"$ref": "#/$defs/text_list"}
            }
          }
        },
        "auditory_scales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["sample", "frame", "gesture", "event", "scene", "session", "archive", "lineage", "infrastructural", "planetary", "unknown"]}
        },
        "sources_of_listening": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["audio", "dsp", "metadata", "transcript", "context", "human", "model", "memory", "audiovisual", "haptic", "none", "other"]}
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "role"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"enum": ["human", "agent", "hybrid"]},
              "role": {"type": "string", "minLength": 1},
              "report_ref": {"type": ["string", "null"]}
            }
          }
        },
        "action_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scopes", "requires_confirmation"],
          "properties": {
            "mode": {"enum": ["observe_only", "recommend", "request", "execute_scoped"]},
            "scopes": {"$ref": "#/$defs/text_list"},
            "granted_by": {"type": ["string", "null"]},
            "expires_at": {"type": ["string", "null"]},
            "requires_confirmation": {"type": "boolean"},
            "reversible": {"type": ["boolean", "null"]}
          }
        },
        "honest_absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "attributed_to"],
            "properties": {
              "kind": {"enum": ["unavailable", "withheld", "refused", "not_retained", "forgotten", "undetermined"]},
              "subject": {"type": "string", "minLength": 1},
              "attributed_to": {"type": "string", "minLength": 1},
              "count": {"type": ["integer", "null"], "minimum": 0},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["statement"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "category": {"enum": ["heard", "measured", "inferred", "interpreted", "speculative", "undetermined"]},
              "confidence": {"enum": ["high", "medium", "low", "undetermined"]},
              "basis": {"type": "string"},
              "source": {"enum": ["audio", "dsp", "metadata", "model", "transcript", "context", "memory", "human"]},
              "speech_content": {"type": "boolean"},
              "time_range": {
                "type": ["object", "null"],
                "properties": {"start_s": {"type": "number"}, "end_s": {"type": "number"}},
                "required": ["start_s", "end_s"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "measurements": {"type": "object"},
    "caption": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "transcript": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "events": {"type": "array"},
    "speech": {"type": "object"},
    "music": {"type": "object"},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "raw_report": {}
  },
  "$defs": {
    "text_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  }
}

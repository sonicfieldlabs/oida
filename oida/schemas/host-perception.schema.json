{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oida.local/schemas/host-perception.schema.json",
  "title": "Oída host perception input",
  "description": "Structured model perception or separately attributable human observation supplied through Hermes, Codex, Claude, OpenClaw, OpenCode, or another audio-capable host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "source", "observations"],
  "properties": {
    "contract": {"enum": ["oida/host-perception/v0.3", "oida/host-perception/v0.4"]},
    "host": {
      "type": "object",
      "required": ["id", "model"],
      "properties": {
        "id": {"enum": ["hermes", "codex", "claude", "openclaw", "opencode", "generic"]},
        "model": {"type": "string", "minLength": 1},
        "provider": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "audio_input_capable": {"type": "boolean"},
        "thinking_budget": {"type": ["integer", "null"], "minimum": 0},
        "wall_ms": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "listening_identity": {
      "description": "Host declaration that the named LISTENING.md revision oriented this perception. This is provenance, never evidence.",
      "type": "object",
      "required": ["contract", "sha256", "applied"],
      "properties": {
        "contract": {"const": "oida/listening-identity/v0.1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "applied": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["live_input", "system_output", "file", "buffer", "generated", "external_stream"]},
        "uri": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "duration_s": {"type": ["number", "null"], "minimum": 0},
        "sample_rate": {"type": ["integer", "null"], "minimum": 0},
        "channels": {"type": ["integer", "null"], "minimum": 0},
        "audio_available_to_oida": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "apparatus": {
      "type": "object",
      "properties": {
        "substrate": {"type": "string"},
        "perception_sources": {"type": "array", "items": {"type": "string"}},
        "model_ids": {"type": "array", "items": {"type": "string"}},
        "sample_rate_hz": {"type": ["integer", "null"]},
        "channels": {"type": ["integer", "null"]},
        "bandwidth_limit_hz": {"type": ["integer", "null"]},
        "absolute_level_calibrated": {"type": "boolean"},
        "known_blind_spots": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "listening_context": {
      "description": "Host-declared situated listening context. Current hosts use AKOÚŌ context v2; the v1 branch remains a permissive read-compatibility boundary. Oída preserves either as attributed input but computes its own effective context and authority.",
      "oneOf": [
        {
          "type": "object",
          "required": ["contract", "position", "apertures", "auditory_scales", "sources_of_listening", "participants", "action_authority", "honest_absences", "listening_passes", "route_decisions"],
          "properties": {
            "contract": {"const": "akouo/listening-context/v2"},
            "listening_passes": {"type": "array"},
            "route_decisions": {"type": "array"}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["contract"],
          "properties": {"contract": {"const": "akouo/listening-context/v1"}},
          "additionalProperties": true
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["statement"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "category": {"enum": ["heard", "measured", "inferred", "interpreted", "speculative", "undetermined"], "description": "heard is accepted only with source=human; machine observations are normalized to inferred."},
              "confidence": {"enum": ["high", "medium", "low", "undetermined"]},
              "basis": {"type": "string"},
              "source": {"enum": ["audio", "dsp", "metadata", "model", "transcript", "context", "memory", "human"]},
              "speech_content": {"type": "boolean"},
              "listening_pass_id": {"type": "string", "minLength": 1, "description": "Required by Oída normalization when category=heard and source=human."},
              "time_range": {
                "type": ["object", "null"],
                "properties": {"start_s": {"type": "number"}, "end_s": {"type": "number"}},
                "required": ["start_s", "end_s"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "measurements": {"type": "object"},
    "caption": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "transcript": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "events": {"type": "array"},
    "speech": {"type": "object"},
    "music": {"type": "object"},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "raw_report": {}
  }
}
